// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  displayName       String
  age               Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  onboarding        Onboarding?
  relapses          Relapse[]
  chatMemory        ChatMemory?
  chats             Chat[]
  recoveryCompanion RecoveryCompanion?
  recoveryPlan      RecoveryPlan?
}

model RecoveryCompanion {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  countryCode  String
  permissions  String[]
  createdAt    DateTime @default(now())
}

model Onboarding {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Type of addiction
  addictionTypes          String[] // Array of addiction type enums as strings
  
  // When it happens
  whenItHappens           String[] // Array of when options as strings
  
  // How it makes you feel
  feelAfter               String?  // Single selection
  
  // Patterns
  frequency               String?  // Single selection
  frequencyQuantity       Int?     // How many cigarettes
  frequencyUnit           String?  // 'per_week' or 'per_day'
  moneySpent              String?  // Amount spent as string
  moneySpentPerDay        Float?   // Calculated money spent per day
  impactAreas             String[] // Array of impact areas
  
  // Intention & Duration
  intention               String?  // Single selection: 'reduce', 'pause', 'just_understand'
  duration                String?  // Single selection: '7_days', '14_days', '30_days', 'not_sure'
  
  // Journey tracking
  journeyStartDate        DateTime? // When the quit smoking journey started
  
  completedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Relapse {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relapseDate       DateTime @default(now())
  createdAt         DateTime @default(now())
  
  @@index([userId])
}

model ChatMemory {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary       String   @default("")   // rolling conversation summary
  lastUpdated   DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Chat {
  id        String   @id @default(uuid())
  userId    String
  message   String
  reply     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model RecoveryPlan {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Input data used to generate the plan
  addictionType           String   // e.g., "cigarette"
  dailyConsumption        Int      // e.g., 18
  yearsOfAddiction        Float    // e.g., 7.0
  ftndScore               Int?     // Fagerstrom score
  dependenceLevel         String?  // "low", "moderate", "high"
  triggers                String[] // Array of trigger strings
  
  // Generated plan output
  planSummary             String   // AI-generated explanation
  addictionSeverity       String   // "Low", "Moderate", "High"
  relapseRisk             String   // "Low", "Medium", "High"
  futureDailyLimits       Int[]    // Array of daily limits [18,18,17,17,...]
  recoveryDurationDays    Int      // Total days in plan
  
  // AI Recommendations (stored as JSON text)
  nicotineReplacement     Boolean?
  behavioralTips          String[] // Array of tips
  triggerStrategies       String[] // Array of strategies
  exerciseTips            String[] // Array of exercise tips
  
  // Tracking
  currentDayIndex         Int      @default(0) // Current day in the plan (0-based)
  startedAt               DateTime @default(now())
  lastUpdatedAt           DateTime @updatedAt
  createdAt               DateTime @default(now())
  
  @@index([userId])
}